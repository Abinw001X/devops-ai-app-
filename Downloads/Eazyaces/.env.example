# Shared application configuration. Replace all placeholders outside source control.
DATABASE_URL=postgresql://kaamsetu:replace-me@localhost:5432/kaamsetu
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
ADMIN_BOOTSTRAP_KEY=replace-with-a-one-time-bootstrap-key
UPLOAD_DIR=./uploads/kyc
PROFILE_UPLOAD_DIR=./uploads/profiles
PUBLIC_API_URL=http://localhost:4000

# Booking service and internal auth-to-notification handoff.
INTERNAL_SERVICE_SECRET=replace-with-a-shared-random-secret
NOTIFICATION_SERVICE_URL=http://localhost:4001
REDIS_URL=

# Razorpay payments and RazorpayX payouts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_AUTO_CAPTURE=true
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Critical email via Resend. No SMTP transport is currently implemented.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# S3-compatible storage. Use workload identity/role credentials in cloud where possible.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Public client values are baked into the Next.js image at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:4001/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Compose-only values. Compose services run only with --profile optional-stack.
POSTGRES_USER=kaamsetu
POSTGRES_PASSWORD=replace-with-a-local-only-password
COMPOSE_DATABASE_URL=postgresql://kaamsetu:replace-with-a-local-only-password@postgres:5432/kaamsetu
COMPOSE_REDIS_PASSWORD=replace-with-a-local-only-password